APP_ENV=local
DATABASE_URL=sqlite:///./warrantywise.db
# Do not commit real secrets. Railway will inject DATABASE_URL for Postgres.
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Required only when controlled LLM response drafting is enabled.
OPENAI_API_KEY=
# Set to a model available in your OpenAI account.
OPENAI_MODEL=
# When OPENAI_API_KEY or OPENAI_MODEL is missing, the app marks LLM drafting
# as not_configured and continues with deterministic response generation.
LLM_RESPONSE_DRAFTING_ENABLED=true

# Optional LangSmith tracing for Phase 2 observability.
# Set LANGSMITH_TRACING=true and LANGSMITH_API_KEY to enable traces.
# LANGSMITH_PROJECT controls which LangSmith project receives traces.
# If not configured, the app runs normally without fake trace links.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=decisiontrace-phase2
LANGSMITH_ENDPOINT=

ANTHROPIC_API_KEY=
